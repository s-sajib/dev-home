{
  "name": "work-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Personal local-first inbox merging Jira, GitHub, WhatsApp and Apple Reminders",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "demo": "WORK_INBOX_DEMO=1 bun --hot src/server/index.ts",
    "poll": "bun src/server/poll-once.ts",
    "test": "bun --bun vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "bun --bun vitest",
    "test:e2e": "playwright test",
    "test:all": "bun run typecheck && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@animateicons/react": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
