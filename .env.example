# Jira (Cloud, API token)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# GitHub (personal access token)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Tuning (optional)
# POLL_MINUTES=5
# STALE_DAYS=5
# REPLY_HOURS=4
# WORK_START_HOUR=9
# WORK_END_HOUR=18

# Claude (uses the logged-in `claude` CLI, no API key needed)
# CLAUDE_MODEL=haiku
# AUTO_JUDGE=1
# Set to 1 only after confirming client/team chat text may be sent to an LLM
# ALLOW_CHAT_TO_LLM=0

# Reminders (macOS)
# REMINDERS_LIST=Work Inbox
# Status names offered on the `t` key
# JIRA_TRANSITIONS=In Progress,In Review,Done

# WhatsApp via WAHA (leave WAHA_URL unset to disable). See SPIKE.md
# WAHA_URL=http://localhost:3000
# WAHA_API_KEY=
# WAHA_WEBHOOK_TOKEN=
# WA_MY_IDS=15551234567@c.us,98765432101@lid
