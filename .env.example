# Jira (Cloud, API token)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# GitHub (personal access token)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Tuning (optional)
# POLL_MINUTES=5
# STALE_DAYS=5
# REPLY_HOURS=4
# Nag window (local time). 8 -> 1 means 08:00 to 01:00; days 0=Sun..6=Sat
# WORK_START_HOUR=8
# WORK_END_HOUR=1
# WORK_DAYS=0,1,2,3,4,5,6

# Claude (uses the logged-in `claude` CLI, no API key needed)
# CLAUDE_MODEL=haiku
# AUTO_JUDGE=1
# WhatsApp summaries: default number of messages (UI offers 20/50/100/200/custom)
# SUMMARY_MESSAGES=20

# Reminders (macOS)
# REMINDERS_LIST=Work Inbox
# Status names offered on the `t` key
# JIRA_TRANSITIONS=In Progress,In Review,Done

# WhatsApp via WAHA (leave WAHA_URL unset to disable). See SPIKE.md
# WAHA_URL=http://localhost:3000
# WAHA_API_KEY=
# WAHA_WEBHOOK_TOKEN=
# WA_MY_IDS=15551234567@c.us,98765432101@lid
